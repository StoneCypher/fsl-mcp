{
  // Visit https://aka.ms/tsconfig to read more about this file
  // MCP SDK v2's .d.mts files reference Buffer. TypeScript 6.0 stops
  // auto-including @types/*, so `"node"` must stay in the `types` array
  // below - it is already there, and a bump past 5.x breaks the moment it
  // is dropped. Never remove it.
  "compilerOptions": {
    // File Layout
    // "rootDir": "./src",
    "outDir": "./build/ts/",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "esnext",
    "types": ["vitest/globals", "node"],
    // "lib": ["esnext"],
    // "types": ["DOM"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "isolatedDeclarations": true,

    // Style Options
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  },
  "include": ["./src/ts/**/*.ts"],
  "exclude": ["**/*.spec.ts", "**/*.stoch.ts", "**/*.mutat.ts"]
}
